module frame_buffer (
  I_clk_d,
  IE_d,
  vblank_clear_Z,
  ADDRESS_d,
  COLOUR_d,
  pixel_address_Z,
  INTERRUPT_d,
  bgcolour_Z,
  pixel_colour
)
;
input I_clk_d;
input IE_d;
input vblank_clear_Z;
input [12:0] ADDRESS_d;
input [1:0] COLOUR_d;
