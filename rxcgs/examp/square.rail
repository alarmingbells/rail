function init;
    var x 45;
    var y 45;
return 0;

function onFrame;
    setPx y x g;
return frame;

main:
    #init;
    bindFrame onFrame;
    while (true;);
        if (p1Up;);
            subfrom y 1;
            sleep 50;
        end;
        if (p1Right;);
            addto x 1;
            sleep 50;
        end;
        if (p1Down;);
            addto y 1;
            sleep 50;
        end;
        if (p1Left;);
            subfrom x 1;
            sleep 50;
        end;
    end;
end;