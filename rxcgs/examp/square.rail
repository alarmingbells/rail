function init;
    var x 45;
    var y 45;

    var px 30;
    var py 45;

    var pmh 1;
    var pmy 1;

    var pdx 1;
    var pdy 1;

    var compx 0;
    var compy 0;
    
    var score 0;
    var frameCount 0;
    var time 0;
    var timeHigh 0;
return 0;

function onFrame;
    if (score == 0;);
        #print0 1;
    end;
    if (score == 1;);
        #print1 1;
    end;
    if (score == 2;);
        #print2 1;
    end;
    if (score == 3;);
        #print3 1;
    end;
    if (score == 4;);
        #print4 1;
    end;
    if (score == 5;);
        #print5 1;
    end;
    if (score == 6;);
        #print6 1;
    end;
    if (score == 7;);
        #print7 1;
    end;
    if (score == 8;);
        #print8 1;
    end;
    if (score == 9;);
        #print9 1;
    end;

    if (timeHigh == 0;);
        #print0 10;
    end;
    if (timeHigh == 1;);
        #print1 10;
    end;
    if (timeHigh == 2;);
        #print2 10;
    end;
    if (timeHigh == 3;);
        #print3 10;
    end;
    if (timeHigh == 4;);
        #print4 10;
    end;
    if (timeHigh == 5;);
        #print5 10;
    end;
    if (timeHigh == 6;);
        #print6 10;
    end;
    if (timeHigh == 7;);
        #print7 10;
    end;
    if (timeHigh == 8;);
        #print8 10;
    end;
    if (timeHigh == 9;);
        #print9 10;
    end;

    if (time == 0;);
        #print0 15;
    end;
    if (time == 1;);
        #print1 15;
    end;
    if (time == 2;);
        #print2 15;
    end;
    if (time == 3;);
        #print3 15;
    end;
    if (time == 4;);
        #print4 15;
    end;
    if (time == 5;);
        #print5 15;
    end;
    if (time == 6;);
        #print6 15;
    end;
    if (time == 7;);
        #print7 15;
    end;
    if (time == 8;);
        #print8 15;
    end;
    if (time == 9;);
        #print9 15;
    end;
    setPx y x r;
    addto y 1;
    setPx y x r;
    addto x 1;
    setPx y x r;
    subfrom y 1;
    setPx y x r;
    subfrom x 1;

    setPx py px g;
    addto frameCount 1;
return frame;

main:
    #init;
    bindFrame onFrame;
    while (true;);
        if (p1Up;);
            subfrom y 1;
        end;
        if (p1Right;);
            addto x 1;
        end;
        if (p1Down;);
            addto y 1;
        end;
        if (p1Left;);
            subfrom x 1;
        end;
        if (px < 2;);
            assign pdx 1;
        end;
        if (px > 78;);
            assign pdx 0;
        end;
        if (py < 2;);
            assign pdy 1;
        end;
        if (py > 78;);
            assign pdy 0;
        end;
        
        assign compx (x;);
        assign compy (y;);
        if (px == compx;);
            if (py == compy;);
                assign pdy 0;
                assign pdx 0;
                addto score 1;
            end;
        end;
        addto compx 1;
        if (px == compx;);
            if (py == compy;);
                assign pdy 0;
                assign pdx 1;
                addto score 1;
            end;
        end;
        addto compy 1;
        if (px == compx;);
            if (py == compy;);
                assign pdy 1;
                assign pdx 1;
                addto score 1;
            end;
        end;
        subfrom compx 1;
        if (px == compx;);
            if (py == compy;);
                assign pdy 1;
                assign pdx 0;
                addto score 1;
            end;
        end;

        if (frameCount > 29;);
            addto time 1;
            assign frameCount 0;
            if (time > 9;);
                addto timeHigh 1;
                assign time 0;
                if (timeHigh == 9;);
                    #reset;
                end;
            end;
        end;

        if (score == 10;);
            #reset;
        end;
        sleep 25;
        if (pdx == 1;);
            assign px (px + pmh;);
        end;
        if (pdy == 1;);
            assign py (py + pmy;);
        end;
        if (pdx == 0;);
            assign px (px - pmh;);
        end;
        if (pdy == 0;);
            assign py (py - pmy;);
        end;
    end;
end;